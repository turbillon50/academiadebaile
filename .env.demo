# =====================================================================
# Academia de Baile — MODO DEMO (sin servicios externos)
# Este archivo lo copia `npm run demo` a `.env.local`. NO usar en producción.
# Para producción real, parte de `.env.example` con credenciales verdaderas.
# =====================================================================

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Activa el modo demo: usa Postgres local (driver node-postgres) y omite Clerk.
DEMO_MODE="1"
NEXT_PUBLIC_DEMO_MODE="1"

# Postgres local (Docker). No requiere Neon.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/academiadebaile"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@127.0.0.1:5432/academiadebaile"

# Valores ficticios: en modo demo no se usan (no hay login ni cobros reales).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_Y2xlcmsuZXhhbXBsZS5jb20k"
CLERK_SECRET_KEY="sk_test_demo"
STRIPE_SECRET_KEY="sk_test_demo"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_demo"
STRIPE_WEBHOOK_SECRET="whsec_demo"
MERCADOPAGO_ACCESS_TOKEN="APP_USR-demo"
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="APP_USR-demo"
RESEND_API_KEY="re_demo"
RESEND_FROM_EMAIL="Academia de Baile <demo@example.com>"
