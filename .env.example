# =====================================================================
# Academia de Baile — variables de entorno
# Copia este archivo a `.env.local` (desarrollo) y configura los valores.
# En Vercel, agrega estas variables en Project Settings → Environment Variables.
# =====================================================================

# ---------- App ----------
# URL pública del sitio (sin slash final). En local: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------- Base de datos: Neon Postgres ----------
# Cadena de conexión "pooled" de Neon (con -pooler). Úsala para la app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/academiadebaile?sslmode=require"
# Cadena de conexión directa (sin pooler). Úsala para migraciones con drizzle-kit.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/academiadebaile?sslmode=require"

# ---------- Auth: Clerk ----------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxx"
CLERK_SECRET_KEY="sk_test_xxx"
# Secreto para verificar los webhooks de Clerk (sincroniza usuarios → DB).
CLERK_WEBHOOK_SECRET="whsec_xxx"
# Rutas de Clerk (no cambiar salvo que muevas las páginas).
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/app"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/app"

# ---------- Pagos: Stripe (tarjetas internacionales) ----------
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ---------- Pagos: Mercado Pago (México) ----------
MERCADOPAGO_ACCESS_TOKEN="APP_USR-xxx"
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="APP_USR-xxx"
# Secreto para validar la firma de los webhooks de Mercado Pago.
MERCADOPAGO_WEBHOOK_SECRET="xxx"

# ---------- Correo: Resend ----------
RESEND_API_KEY="re_xxx"
RESEND_FROM_EMAIL="Academia de Baile <hola@tudominio.com>"

# ---------- Recordatorios: WhatsApp / n8n (opcional) ----------
# Webhook entrante de n8n que dispara recordatorios de clase por WhatsApp.
N8N_REMINDER_WEBHOOK_URL=""
# Secreto compartido que enviamos en el header para que n8n valide el origen.
N8N_WEBHOOK_SECRET=""
